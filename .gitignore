# Настройки хранилища Obsidian хранятся вместе с репозиторием: тема,
# плагины и раскладка панелей должны работать сразу после клонирования.
# Исключения ниже — либо личное, либо восстанавливается само.

# Настройки плагинов: содержат поля для ключей API,
# а значения в них и так совпадают с умолчаниями плагинов
.obsidian/plugins/*/data.json
.obsidian/plugins/*/backups/

# Служебные файлы macOS
.DS_Store

# Состояние окна: открытые вкладки, последний открытый файл, ширины панелей.
# У каждого читателя своё, в репозиторий не попадает.
.obsidian/workspace.json
.obsidian/workspaces.json

# Локальная корзина Obsidian
.trash/
